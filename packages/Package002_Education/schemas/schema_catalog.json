        {"name": "contact_details", "type": "string", "description": "Added in RC2. Official phone/email if publicly listed; populated for 5 flagship rows only as of RC2, PENDING_VERIFICATION elsewhere."},
        {"name": "student_services_summary", "type": "string", "description": "Added in RC2. Brief factual note on hostel/library/sports-complex presence; populated for 5 flagship rows only as of RC2, PENDING_VERIFICATION elsewhere."},
        {"name": "data_source", "type": "string"},
        {"name": "source_url", "type": "string"},
        {"name": "collection_date", "type": "date"},
        {"name": "confidence_score", "type": "integer", "range": [0, 100]},

        {"name": "id", "type": "uuid", "description": "Unique row identifier (UUIDv4)"},
        {"name": "name", "type": "string", "description": "Official name of the board/regulatory body"},
        {"name": "type", "type": "string", "description": "Category, e.g. Central Regulatory Body, State Board - Secondary, Accreditation Body"},
        {"name": "jurisdiction", "type": "enum", "values": ["National", "Telangana", "Andhra Pradesh"], "description": "Scope of authority"},
        {"name": "parent_ministry_or_department", "type": "string", "description": "Governing ministry/department, if applicable"},
        {"name": "established_year", "type": "string", "description": "Year established (or PENDING_VERIFICATION)"},
        {"name": "official_website", "type": "string", "description": "Official website URL"},
        {"name": "headquarters_city", "type": "string"},
        {"name": "headquarters_state", "type": "string"},
        {"name": "mandate_summary", "type": "string", "description": "Brief factual description of the body's mandate"},
        {"name": "data_source", "type": "string", "description": "Human-readable source label"},
        {"name": "source_url", "type": "string", "description": "URL of the specific source used"},
        {"name": "collection_date", "type": "date"},
        {"name": "confidence_score", "type": "integer", "range": [0, 100]},
        {"name": "verification_status", "type": "enum", "values": ["VST-NEEDS_REVIEW", "VST-VERIFIED"]},
        {"name": "notes", "type": "string"}
      ]
    },
    {

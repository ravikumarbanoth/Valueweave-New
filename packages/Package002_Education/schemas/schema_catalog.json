  "relationship_to_package001": "No hard foreign keys into Package001_Geography exist yet in v1.0.0 — state/jurisdiction fields here are free-text values ('Telangana', 'Andhra Pradesh', 'National') rather than district_id references, because per-row district-level attribution was not independently verifiable for most entities in this release. Wiring these fields to Package001_Geography's state.csv / district.csv primary keys is tracked as future work (see acquisition_backlog.json).",
  "datasets": [
    {
      "dataset_name": "education_boards_regulatory_bodies",
      "file": "datasets/education_boards_regulatory_bodies.csv",
      "primary_key": "id",
      "foreign_keys": [],
